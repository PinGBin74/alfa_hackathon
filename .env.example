# ---------- База данных ----------
POSTGRES_USER=alfa
POSTGRES_PASSWORD=
POSTGRES_DB=alfa_news
# Адрес БД собирается из POSTGRES_*; вне Docker - хост localhost (POSTGRES_HOST, POSTGRES_PORT).
# Свой адрес целиком: DATABASE_URL=postgresql+psycopg://...

# ---------- LLM (только модели из Приложения 3 задания) ----------
# OpenAI-совместимый прокси организаторов; LLM_API_KEY - ключ команды
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=changeme

# Роутинг моделей по задачам. Значения - ID моделей в прокси (GET $LLM_BASE_URL/models), не названия
LLM_MODEL_LIGHT=google/gemma-4-26b-a4b-it            # Gemma 4 26B A4B: разметка новостей, план агента
LLM_MODEL_REASONING=z-ai/glm-5.3-flash               # GLM-5.3-Flash: черновик инсайта
LLM_MODEL_GENERAL=qwen/qwen3.6-35b-a3b               # Qwen3.6 35B A3B: уточняющие вопросы (чат)
LLM_MODEL_RESEARCH=deepseek/deepseek-v4.1-flash      # DeepSeek-V4.1-Flash: фактчекинг, позиции банка
LLM_MODEL_TEXT=moonshotai/kimi-k2.6                  # Kimi-K2.6: LLM-судья в eval
LLM_MODEL_VISION=qwen/qwen3-vl-30b-a3b-instruct      # Qwen3-VL-30B-A3B-Instruct: OCR сканов аналитики

# ---------- Бюджет ----------
# Лимит общего ключа: 500 руб/день. Ставим мягкий лимит ниже жёсткого.
DAILY_BUDGET_RUB=450
# Фактическую цену вызова прокси отдаёт в заголовке x-litellm-response-cost;
# эти цены (руб за 1K токенов) - запасная оценка, если заголовка нет
PRICE_PER_1K_INPUT_RUB=0.05
PRICE_PER_1K_OUTPUT_RUB=0.15

# ---------- Эмбеддинги ----------
# Не используются: в списке моделей кейса нет эмбеддинг-модели (поиск - BM25, см. docs/ml.md)
EMBEDDING_DIM=1024
EMBEDDING_MODEL=

# ---------- Приложение ----------
APP_ENV=dev                      # prod: скрыть список тестовых учёток на экране входа (/api/auth/demo-accounts)
JWT_SECRET=change-me-in-prod     # для стенда: openssl rand -hex 32
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:3000   # фронтенд ходит в API через свой /api (nginx или прокси Vite)

# ---------- Ingestion ----------
INGEST_INTERVAL_MINUTES=30
NEWS_MAX_AGE_DAYS=14
