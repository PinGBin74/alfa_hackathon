# ---------- База данных ----------
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa
POSTGRES_DB=alfa_news
# Для запуска backend вне docker:
# DATABASE_URL=postgresql+psycopg://alfa:alfa@localhost:5432/alfa_news

# ---------- LLM (только модели из Приложения 3 задания) ----------
LLM_BASE_URL=https://<endpoint-из-кейса>/v1
LLM_API_KEY=changeme

# Роутинг моделей по сложности задачи
LLM_MODEL_LIGHT=Gemma 4 26B A4B        # классификация, извлечение
LLM_MODEL_REASONING=GLM-5.3-Flash       # глубокий анализ, интерпретация
LLM_MODEL_GENERAL=Qwen3.6 35B A3B       # универсальная
LLM_MODEL_RESEARCH=DeepSeek-V4.1-Flash  # взаимосвязи, большие объёмы
LLM_MODEL_TEXT=Kimi-K2.6                # обработка текста
LLM_MODEL_VISION=Qwen3-VL-30B-A3B-Instruct

# ---------- Бюджет ----------
# Лимит общего ключа: 500 руб/день. Ставим мягкий лимит ниже жёсткого.
DAILY_BUDGET_RUB=450
# Цена за 1k токенов (руб) - уточнить по тарифу кейса
PRICE_PER_1K_INPUT_RUB=0.05
PRICE_PER_1K_OUTPUT_RUB=0.15

# ---------- Эмбеддинги ----------
EMBEDDING_DIM=1024
EMBEDDING_MODEL=changeme

# ---------- Приложение ----------
APP_ENV=dev
JWT_SECRET=change-me-in-prod
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# ---------- Ingestion ----------
INGEST_INTERVAL_MINUTES=30
NEWS_MAX_AGE_DAYS=14
