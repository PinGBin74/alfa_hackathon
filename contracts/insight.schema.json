{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight.schema.json",
  "title": "Insight",
  "description": "Персонализированная интерпретация события. Разделяет подтверждённые факты, позицию банка и выводы модели.",
  "type": "object",
  "required": ["insight_id", "client_id", "news_id", "what_happened", "why_it_matters", "consequences", "bank_position", "ai_inference", "sources", "generated_at"],
  "properties": {
    "insight_id": {"type": "string"},
    "client_id": {"type": "string", "description": "SYNTHETIC_U"},
    "user_role": {"type": "string"},
    "news_id": {"type": "string"},
    "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
    "what_happened": {
      "type": "object",
      "required": ["summary", "confirmed_facts"],
      "properties": {
        "summary": {"type": "string"},
        "confirmed_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "why_it_matters": {
      "type": "array",
      "description": "Связь события с признаками компании.",
      "items": {
        "type": "object",
        "required": ["text", "client_features"],
        "properties": {
          "text": {"type": "string"},
          "client_features": {"type": "array", "items": {"type": "string"}, "description": "Например: MAINOKVED_CODE, CL_PRODUCT_LOA_MARK"}
        }
      }
    },
    "consequences": {
      "type": "object",
      "properties": {
        "risks": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
        "opportunities": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
        "factors_to_watch": {"type": "array", "items": {"type": "string"}}
      }
    },
    "suggested_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {"type": "string"},
          "kind": {"enum": ["action", "question", "scenario", "product"]},
          "product_code": {"type": "string", "description": "Нативная реклама банковского продукта, если уместно"}
        }
      }
    },
    "bank_position": {
      "type": "array",
      "description": "Выводы, основанные на аналитике Альфа-Банка.",
      "items": {
        "type": "object",
        "required": ["text", "analytics_doc_id"],
        "properties": {
          "text": {"type": "string"},
          "analytics_doc_id": {"type": "string"},
          "quote_ref": {"type": "string", "description": "Страница/чанк материала"}
        }
      }
    },
    "ai_inference": {
      "type": "array",
      "description": "Выводы, сформированные моделью. Помечаются в UI как AI.",
      "items": {"$ref": "#/$defs/statement"}
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "type"],
        "properties": {
          "source_id": {"type": "string"},
          "type": {"enum": ["news", "bank_analytics", "client_data"]},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "published_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "confidence": {"enum": ["low", "medium", "high"]},
    "verification": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "iterations": {"type": "integer"}
      }
    },
    "trace_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["text", "source_id"],
      "properties": {
        "text": {"type": "string"},
        "source_id": {"type": "string"}
      }
    },
    "statement": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "basis": {"type": "array", "items": {"type": "string"}, "description": "source_id или имена признаков клиента"}
      }
    }
  }
}
